              "pm.test('Updated age', () => pm.expect(pm.response.json().post.age).to.equal(21));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read updated post (also run after restarting server) — 200",
      "request": {
        "method": "GET",
        "header": [],
