              "pm.test('Created post exists', () => pm.expect(pm.response.json().some(post => post._id === pm.collectionVariables.get('postId'))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "Update post — 200",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/posts/update/{{postId}}",
        "description": "Expected HTTP 200.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Updated from Postman\",\n  \"age\": 21\n}",
          "options": {
            "raw": {
              "language": "json"
