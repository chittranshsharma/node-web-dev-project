{
  "info": {
    "name": "Backend assignment — local API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests in order. Login checks credentials only; logout does not invalidate a session. All post routes are public. Use disposable example data."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "demoPassword123"
    },
    {
      "key": "postId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Server check — 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/",
        "description": "Expected HTTP 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('No password or hash in response', () => { const text = pm.response.text(); pm.expect(text).not.to.include('\"password\":'); pm.expect(text).not.to.include('$2b$'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Register a fresh user — 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/users/register",
        "description": "Expected HTTP 201.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now() + '-' + Math.floor(Math.random() * 100000);",
              "pm.collectionVariables.set('username', 'demo' + suffix);",
              "pm.collectionVariables.set('email', 'demo' + suffix + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('No password or hash in response', () => { const text = pm.response.text(); pm.expect(text).not.to.include('\"password\":'); pm.expect(text).not.to.include('$2b$'); });"
            ]
          }
        }
      ]
    },
    {
